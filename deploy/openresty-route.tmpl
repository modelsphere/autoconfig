{{- /* autoconfig openresty 路由模板:每条 route 生成整个 session_route_<route>.conf。
     Values: route(短名,用于 dict/register)、listen(端口)、可选 override(ttft_limit_ms/tps_limit_tps/default_max/adaptive_cc_min)。
     Peers: 发现结果(agent 注入)。骨架对齐真实 session_route_glm.conf。 */ -}}
# {{.Values.route}} 路由(autoconfig 模板生成,勿手改;改模板或 agent 配置)
lua_shared_dict active_conns_{{.Values.route}} 4m;
lua_shared_dict cluster_avg_{{.Values.route}}  16k;
lua_shared_dict lc_locks_{{.Values.route}}     1m;
lua_shared_dict bad_peers_{{.Values.route}}    1m;
lua_shared_dict bodylog_ctl_{{.Values.route}}  1m;
lua_shared_dict cch_ctl_{{.Values.route}}      1m;

server {
    listen {{.Values.listen}};
    server_name _;
    set $route "{{.Values.route}}";

    set_by_lua_block $__{{.Values.route}}_init {
        _G.register_route("{{.Values.route}}", function()
            return {
                peers = {
{{- range .Peers}}
                    {"{{.IP}}", {{.Port}}, "{{.Name}}"},
{{- end}}
                },
{{- if .Values.ttft_limit_ms}}
                ttft_limit_ms = {{.Values.ttft_limit_ms}},
{{- end}}
{{- if .Values.tps_limit_tps}}
                tps_limit_tps = {{.Values.tps_limit_tps}},
{{- end}}
{{- if .Values.adaptive_cc_min}}
                adaptive_cc_min = {{.Values.adaptive_cc_min}},
{{- end}}
{{- if .Values.default_max}}
                default_max = {{.Values.default_max}},
{{- end}}
            }
        end)
        return ""
    }

    include conf.d/router_locations.inc;
}
