# autoconfig-hagate image: the leader-election gate sidecar for master-standby
# (cmd/hagate). It runs next to openresty / CART / monitor; only the pod holding the
# Lease labels itself <name>-active, and the Service selects on that label, so only
# the leader is in the Service endpoints. Multi-stage, dependencies from GOPROXY.
#   docker build -f Dockerfile.hagate -t autoconfig-hagate:dev .
# The base images and GOPROXY default to public sources; override them with --build-arg.
ARG GO_BASE=golang:1.23.3-alpine3.20
ARG RUNTIME_BASE=python:3.12-alpine
ARG GOPROXY=https://proxy.golang.org,direct

FROM ${GO_BASE} AS build
ARG GOPROXY
ENV GOPROXY=${GOPROXY} GOSUMDB=off GOTOOLCHAIN=local CGO_ENABLED=0 GOOS=linux GOARCH=amd64
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -ldflags="-s -w" -o /out/hagate ./cmd/hagate

FROM ${RUNTIME_BASE}
COPY --from=build /out/hagate /usr/local/bin/hagate
ENTRYPOINT ["/usr/local/bin/hagate"]
