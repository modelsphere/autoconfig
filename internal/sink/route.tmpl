{{- /* autoconfig openresty 路由模板:每条 route 生成整个 session_route_<route>.conf。
     路径路由:server 只监听 unix socket(名 = Route = 外部路径 key),由镜像自带的 8080 dispatch
     按 /<Route>/ 派生 socket 分发;不监听 per-model TCP 端口。
     Route(短名,用于 dict/register/socket 名)、Extra(任意调优项)、Peers(发现结果)。 */ -}}
# {{.Route}} 路由(autoconfig 模板生成,勿手改;改模板或 ModelRoute)
lua_shared_dict active_conns_{{.Route}} 4m;
lua_shared_dict cluster_avg_{{.Route}}  16k;
lua_shared_dict lc_locks_{{.Route}}     1m;
lua_shared_dict bad_peers_{{.Route}}    1m;
lua_shared_dict bodylog_ctl_{{.Route}}  1m;
lua_shared_dict cch_ctl_{{.Route}}      1m;

server {
    listen unix:/usr/local/openresty/nginx/sock/{{.Route}}.sock;   # 路径路由:dispatch(8080)按 /{{.Route}}/ 分发到此 socket
    server_name _;
    set $route "{{.Route}}";

    set_by_lua_block $__{{.Route}}_init {
        _G.register_route("{{.Route}}", function()
            return {
                peers = {
{{- range .Peers}}
                    { {{.LuaTuple}} },
{{- end}}
                },
{{- range $k, $v := .Extra}}
                {{$k}} = {{luaVal $v}},
{{- end}}
{{- /* Raw:已经是 lua 字面量的片段(如 ttft_metrics 的嵌套 table),原样输出不加引号。
       只由 operator 自己生成(见 sink/slo.go),不接受用户自由文本 —— 走 luaVal 会被
       整个当成字符串加引号,引擎读到的就不是 table 了。

       ⚠️⚠️ **这段必须排在 .Extra 之后,顺序有语义**:两边出现同名键时(用户在
       nginx.values 里手写了 ttft_metrics),lua 表构造式里**后写的赢**。排在后面 →
       CRD 的 table 生效;若被挪到前面 → 引擎收到的是 Extra 那份加了引号的字符串 →
       validate_metrics 整份丢弃 → **静默降级成静态阈值**,而且从 source 上看不出异常。
       TestRenderRoute_RawWinsOverExtra 专门守这个顺序,别绕过它重排。 */}}
{{- range $k, $v := .Raw}}
                {{$k}} = {{$v}},
{{- end}}
            }
        end)
        return ""
    }

    include conf.d/router_locations.inc;
}
