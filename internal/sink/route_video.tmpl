{{- /* autoconfig openresty 视频生成路由模板(nginx.mode: video)。

     和 route.tmpl(LLM)的根本差别:这里**不进 lua 引擎**。LLM 那套要解析请求体取 model、
     做会话亲和、按 TTFT/TPS 限流、自适应并发;而 H3 这类服务是「异步建任务 + 轮询 + 大文件下载」,
     请求体可能是 64MB 的 base64 图,响应可能是几十 MB 的视频流,上面每一条都不适用甚至有害。
     所以退化成一个直白的反向代理:轮询 upstream、放开超时、关响应缓冲、补转发头。

     路径:dispatch(8080)按 /<Route>/ 分发到本 socket **并剥掉前缀**,后端收到的是干净路径。
     因此对外地址是 https://<域名>/<Route>/v2/...,下游若要自己拼下载 URL(H3 的
     content.url),必须把 /<Route> 前缀算进去 —— H3 用 H3_PUBLIC_BASE_URL 配。 */ -}}
{{- /* vproxy:两个 location(通用 / + 下载专用)共用的反向代理指令。nginx 里 location 之间不继承,
       所以抽成 define 避免两处重复,改一处两边都变。 */ -}}
{{- define "vproxy"}}
        proxy_pass http://backend_{{.Route}};
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host  $fwdhost_{{.Var}};
        proxy_set_header X-Forwarded-Proto $fwdproto_{{.Var}};
        # Range 必须原样带过去:下载接口支持断点续传,漏了就只能整段下。
        proxy_set_header Range             $http_range;
        proxy_set_header If-Range          $http_if_range;

        # 生成一条视频要 1~3 分钟,下载几十 MB 也可能很慢 —— 超时按小时给。
        proxy_connect_timeout {{.ConnectTimeout}};
        proxy_send_timeout    {{.ProxyTimeout}};
        proxy_read_timeout    {{.ProxyTimeout}};
        # 请求缓冲保持默认 on:客户端慢时先收完再转给后端,免得占着后端连接。
        proxy_request_buffering on;
{{- end -}}
# {{.Route}} 视频生成路由(autoconfig 模板生成,勿手改;改模板或 ModelRoute)
# mode: video —— 纯反向代理,不走 lua 路由引擎(无会话亲和/TPS 限流/自适应并发)

# 转发头:优先透传外层网关给的值,没有才用本机看到的。
# 下游(如 H3)按 X-Forwarded-Host/Proto 拼对外 URL;这里若无条件写 $scheme,
# TLS 在更外层终止时会拼出 http:// 的地址。
map $http_x_forwarded_proto $fwdproto_{{.Var}} {
    default $http_x_forwarded_proto;
    ""      $scheme;
}
map $http_x_forwarded_host $fwdhost_{{.Var}} {
    default $http_x_forwarded_host;
    ""      $host;
}

{{- if .UploadConnLimit}}
# 每 IP 并发连接上限。上传方向 nginx 没有字节级限速指令(limit_rate/proxy_limit_rate 只作用于响应),
# 能控的是「同时有几条在传」—— 单条的速率由客户端和网卡决定,但总量 = 并发数 × 单条速率,
# 卡住并发就卡住了单个来源能占的入向带宽。真要按字节限只能在 lua 里自己读 body 加 sleep,
# 那样会丢掉 proxy_request_buffering 的现成反压,不值当。
#
# ⚠️ key 选错,粒度就从"每来源"塌成"全局"。这里**不能用 $binary_remote_addr** ——
# 本路由挂在 unix socket 上(dispatch 按 /<route>/ 分发过来),那一跳没有 IP,
# 实测路由层的 $remote_addr 恒为字符串 "unix:",所有请求会落进同一个桶。
# 默认用 $http_x_real_ip(dispatch 设的 X-Real-IP = openresty 的直连对端)。
# 要精确到"每真实客户端",把 upload_limit_key 配成取 X-Forwarded-For 最左一跳的变量
# (前提是外层网关确实透传了这个头)。
limit_conn_zone {{.UploadLimitKey}} zone=upconn_{{.Var}}:10m;
{{- end}}
{{- if .UploadReqLimit}}
# 每 IP 请求速率上限(令牌桶)。挡的是"狂刷建任务"这类,和并发限一起用。
limit_req_zone {{.UploadLimitKey}} zone=upreq_{{.Var}}:10m rate={{.UploadReqLimit}};
{{- end}}
{{- if .DownloadConnLimit}}
# 下载并发上限 —— **全局(所有客户端合计),不是每客户端**。key 用【常量 {{.Route}}】,所以每个
# 下载请求都落进同一个桶 → 全局计数。配合下面每连接 limit_rate = 总带宽/并发数,得到:
#   全局并发下载 ≤ download_conn_limit,且全局下载带宽 ≤ rate_limit(总带宽)。
map $host $dlkey_{{.Var}} {
    default "{{.Route}}";   # 恒为常量 → 全局单桶(与 $host 取值无关)
}
limit_conn_zone $dlkey_{{.Var}} zone=dlconn_{{.Var}}:10m;
{{- end}}

upstream backend_{{.Route}} {
{{- range .Peers}}
    server {{.IP}}:{{.Port}}{{if .Backup}} backup{{end}};   # {{.Name}}
{{- end}}
    keepalive 16;
}

server {
    listen unix:/usr/local/openresty/nginx/sock/{{.Route}}.sock;   # 路径路由:dispatch(8080)按 /{{.Route}}/ 分发到此 socket
    server_name _;

    # I2V 允许 base64 传图,上游自己在 64MB 处拒;这里放到 64m,别提前 413。
    client_max_body_size {{.MaxBodySize}};
    client_body_buffer_size 1m;
{{- if .UploadConnLimit}}
    limit_conn upconn_{{.Var}} {{.UploadConnLimit}};
{{- end}}
{{- if .UploadReqLimit}}
    limit_req  zone=upreq_{{.Var}}{{if .UploadReqBurst}} burst={{.UploadReqBurst}}{{end}};
{{- end}}
{{- if .DownloadConnLimit}}

    # 下载(/content):更具体的 regex location 优先匹配,提交/查询走下面的 location /。
    # 这里挂全局 limit_conn + 每连接 limit_rate(= 总带宽 / 并发数)。
    location ~ ^/v2/video_generation/[^/]+/content$ {
        limit_conn        dlconn_{{.Var}} {{.DownloadConnLimit}};
        limit_conn_status 429;   # 超全局并发上限返 429(与 API 限流风格一致;默认是 503)
        # 下载是免鉴权路径(content.url 交给最终用户,浏览器不带 Authorization),这里不放 guard。
{{ template "vproxy" . }}
        # 每连接下载限速 = 总带宽 rate_limit ÷ download_conn_limit,**从第一字节起就限**。
        # 这里【不设 limit_rate_after】:下载 location 只服务视频(小 JSON 走 location /),给每连接
        # 1MB 免费全速头会让 N 条连接短暂突破 rate_limit、且 <1MB 的小视频整个逃过限速 —— 削弱
        # 「全局下载带宽 ≤ rate_limit」。spare 小响应的活由 location / 负责,这里不需要。
        # 限速必须开缓冲(proxy_buffering off 时 limit_rate 不生效);
        # proxy_max_temp_file_size 0 = 开缓冲但不落盘,几十 MB 视频内存过一手就发走。
        limit_rate       {{.DownloadRate}};
        proxy_buffering on;
        proxy_max_temp_file_size 0;
    }
{{- end}}

    location / {
{{- if .Auth}}
        {{/*
          API key 鉴权:读 openresty 镜像里的 lua/api_keys.lua —— 与 LLM 路由**同一张表**。
          不在 ModelRoute 里配 key:那样密钥会进 CR 和 chart values(也就进 git),
          而且和 lua 那份成为两个真相源,轮换必漏一个。

          这是本模板唯一一处 lua,只在 access 阶段查一次 header,不解析请求体、
          不参与路由决策 —— "纯反向代理"的性质基本不受影响。
        */}}
        access_by_lua_block { require("api_keys").guard({{if .AuthPublicPaths}}{{"[=["}}{{.AuthPublicPaths}}{{"]=]"}}{{else}}nil{{end}}) }
{{- end}}
{{ template "vproxy" . }}

        # 提交/查询是小 JSON,不缓冲。配了 rate_limit 时,大文件下载已在上面的 /content location
        # 限速(download_conn_limit 只要配了 rate_limit 就必有值,见 openresty.go 里的默认值逻辑,
        # 所以这里不会再出现"配了 rate_limit 但下载不限并发"的旧行为)。没配 rate_limit = 没选限速策略。
        proxy_buffering off;
    }
}
