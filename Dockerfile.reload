# autoconfig-reload image: the reload sidecar (cmd/reload), kept apart from the
# controller. It runs in openresty / CART pods, watches the ConfigMap files and sends
# SIGHUP to the main process when they change. Multi-stage, dependencies from GOPROXY.
#   docker build -f Dockerfile.reload -t autoconfig-reload:dev .
# The base images and GOPROXY default to public sources; override them with --build-arg.
ARG GO_BASE=golang:1.23.3-alpine3.20
ARG RUNTIME_BASE=python:3.12-alpine
ARG GOPROXY=https://proxy.golang.org,direct

FROM ${GO_BASE} AS build
ARG GOPROXY
# TARGETARCH is set by buildx to the platform being built, so a multi-platform build
# compiles each image for its own arch. It was hardcoded to amd64, which put an amd64
# binary into the published arm64 image. A plain `docker build` leaves it empty and Go
# then builds for the host, as before.
ARG TARGETARCH
ENV GOPROXY=${GOPROXY} GOSUMDB=off GOTOOLCHAIN=local CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH}
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -ldflags="-s -w" -o /out/reload ./cmd/reload

FROM ${RUNTIME_BASE}
COPY --from=build /out/reload /usr/local/bin/reload
ENTRYPOINT ["/usr/local/bin/reload"]
